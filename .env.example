# ==============================================================================
# MORTGAGE UNDERWRITING AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables for your local or production setup.
# NEVER commit your actual .env file to version control.
#
# SECURITY (F-05..F-08): the values below are PLACEHOLDERS. There are no working
# credentials or secrets in this file. Outside a development environment the app
# refuses to start unless SECRET_KEY and DATABASE_URL are set explicitly (F-07).

# --- Application Core ---
APP_NAME="Mortgage Underwriting AI"
# development | test | local | ci are the only values that permit throwaway defaults.
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# REQUIRED outside development. Must be >= 32 chars and must not be the dev value (F-07).
SECRET_KEY=

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
# Must be an explicit origin allowlist. '*' is rejected when credentials are enabled (F-06).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# --- API Authentication (F-05) ---
# Leave blank to keep non-public routes fail-closed (503). Provision a random key to
# enable authenticated access to the protected routers.
API_KEY=
# Best-effort in-process limit for public endpoints; 0 disables it.
RATE_LIMIT_PER_MINUTE=120

# --- Frontend Server ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- PostgreSQL Database ---
# REQUIRED outside development (F-07). Use a dedicated least-privilege role in production.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=mortgage_underwriting
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=

# --- Storage Paths (Local / Container) ---
STORAGE_BASE_PATH=./storage
STORAGE_UPLOADS_PATH=./storage/uploads
STORAGE_PROCESSED_PATH=./storage/processed
STORAGE_REPORTS_PATH=./storage/reports

# --- Circle rate ingestion (F-08) ---
# Official portal URL. HTTPS only, and its host MUST appear in CIRCLE_RATE_ALLOWED_HOSTS.
CIRCLE_RATE_SOURCE_URL=
# Comma-separated (or JSON) allowlist of approved outbound hosts. Empty => refuse to fetch.
CIRCLE_RATE_ALLOWED_HOSTS=
CIRCLE_RATE_STATE=UP
CIRCLE_RATE_PILOT_CITY=Lucknow
CIRCLE_RATE_PILOT_DISTRICT=Lucknow
# Local (offline) ingestion is confined to this directory to prevent arbitrary file reads.
CIRCLE_RATE_INTAKE_DIR=./data/raw/circle_rates
INGESTION_SCHEDULE_CRON=0 9 1 * *

# --- Future AI / LLM Configuration (Placeholders for Phase 1+) ---
# Note: Phase 0 runs 100% locally without requiring external API keys.
LLM_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
# Playbook stack: pgvector in the same Postgres instance.
VECTOR_DB_TYPE=pgvector
VECTOR_DB_PATH=./storage/vector_store
# Blank means no active index is trusted; populate only after a gold-set gate passes.
RAG_ACTIVE_INDEX_VERSION=

# --- Raw regulatory document store (MinIO / S3 compatible) ---
# RAW_DOCUMENT_STORE=minio requires MINIO_ACCESS_KEY and MINIO_SECRET_KEY.
# Use local only for tests or offline development; production evidence must be
# stored with its immutable SHA-256 in the object store.
RAW_DOCUMENT_STORE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mortgage-raw-documents
MINIO_SECURE=false

# --- Provider-response cache ---
REDIS_URL=redis://localhost:6379/0
