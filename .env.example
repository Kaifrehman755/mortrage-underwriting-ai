# ==============================================================================
# MORTGAGE UNDERWRITING AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables for your local or production setup.
# NEVER commit your actual .env file to version control.

# --- Application Core ---
APP_NAME="Mortgage Underwriting AI"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend Server ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mortgage_underwriting
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mortgage_underwriting

# --- Storage Paths (Local / Container) ---
STORAGE_BASE_PATH=./storage
STORAGE_UPLOADS_PATH=./storage/uploads
STORAGE_PROCESSED_PATH=./storage/processed
STORAGE_REPORTS_PATH=./storage/reports

# --- Future AI / LLM Configuration (Placeholders for Phase 1+) ---
# Note: Phase 0 runs 100% locally without requiring external API keys.
LLM_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_TYPE=chromadb
VECTOR_DB_PATH=./storage/vector_store
